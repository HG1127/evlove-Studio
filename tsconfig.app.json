{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"],
      "@evolution/contracts": ["./packages/contracts/src/index.ts"],
      "@evolution/core": ["./packages/core/src/index.ts"],
      "@evolution/harness": ["./packages/harness/src/index.ts"],
      "@evolution/adapters/sandbox": ["./packages/adapters/src/sandbox.ts"],
      "@evolution/adapters": ["./packages/adapters/src/index.ts"],
      "@evolution/ui": ["./packages/ui/src/index.ts"],
      "@evolution/testkit": ["./packages/testkit/src/index.ts"]
    }
  },
  "include": ["src", "packages/*/src"]
}
